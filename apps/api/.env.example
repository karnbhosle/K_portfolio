NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/karna_portfolio
ALLOWED_ORIGINS=http://localhost:3000
# 0 = direct connection. Set an exact trusted proxy hop count only behind a known proxy.
TRUST_PROXY=0
# Optional SMTP. Leave blank until a real provider is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Fixed, provider-approved sender. Visitor input never controls this value.
SMTP_FROM=
SMTP_TO=karnabhosle223@gmail.com
# Failed email notifications are retried in the background: 5, 15, 45, 135 minutes...
# 0 disables the worker; otherwise at least 10000 ms.
NOTIFY_RETRY_INTERVAL_MS=300000
# SMTP attempts per message, including the first one made while the visitor waits.
NOTIFY_MAX_ATTEMPTS=5
