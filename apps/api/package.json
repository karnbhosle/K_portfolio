{
  "name": "@karna/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run test/contact.test.ts test/notifier.test.ts",
    "test:integration": "vitest run test/models.test.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@karna/shared": "*",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "mongoose": "9.10.0",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server-core": "11.2.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
