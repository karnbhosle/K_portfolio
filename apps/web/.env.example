# Server-only content API address; content falls back to the shared seed on failure.
API_BASE_URL=http://localhost:4000
# Public API origin used by the contact form and allowed by the Content-Security-Policy.
# Baked in at build time. Without it, a production build shows "email Karna directly" instead of the form sending.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Real public origin. Leave unset until one exists: no canonical URL, sitemap entry or Person URL is emitted.
SITE_URL=
